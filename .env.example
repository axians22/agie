# Copie para .env. Nunca versione o .env.
APP_PORT=8095

# Endereço público do app, com https
APP_ORIGINS=

# Google Cloud > Credenciais > ID do cliente OAuth (aplicativo da Web)
GOOGLE_CLIENT_ID=

# Administrador principal. O Pix e os outros administradores ficam em Config, dentro do app.
ADMIN_EMAILS=

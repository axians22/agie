# Copie para .env. Nunca versione o .env.
APP_PORT=8095

# Endereço público do app, com https
APP_ORIGINS=

# Google Cloud > Credenciais > ID do cliente OAuth (aplicativo da Web)
GOOGLE_CLIENT_ID=

# E-mails de administrador, separados por vírgula
ADMIN_EMAILS=

# Dados da conta que recebe o Pix
PIX_CHAVE=
PIX_NOME=
PIX_CIDADE=
